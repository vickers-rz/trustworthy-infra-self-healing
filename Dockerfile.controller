FROM golang:1.24.0 AS build
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/infraheal-controller ./cmd/controller

FROM scratch
COPY --from=build /out/infraheal-controller /infraheal-controller
USER 65532:65532
ENTRYPOINT ["/infraheal-controller"]
